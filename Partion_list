class ListNode(object):
        def __init__(self, val=0, next=None):
            self.val = val
            self.next = next


class Solution:
    def PartionOfList(self,head,value):
        smallList = ListNode(0)
        bigList = ListNode(0)

        small = smallList
        big = bigList

        current = head

        while current:
            if current.val < value:
                small.next = current
                small = small.next
            else:
                big.next = current
                big = big.next

            current = current.next

        big.next = None
        small.next = bigList.next

        return smallList.next




